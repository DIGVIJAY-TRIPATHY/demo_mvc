<%- include('../partials/header') %>

<div class="page-head page-head-row">
  <div>
    <h1>Tasks</h1>
    <p><a href="/projects/<%= project.id %>"><%= project.name %></a></p>
  </div>
  <% if (manager) { %>
    <a class="btn btn-inline" href="/projects/<%= project.id %>/tasks/new">New task</a>
  <% } %>
</div>

<div class="filters">
  <a class="<%= activeStatus === '' ? 'active' : '' %>" href="/projects/<%= project.id %>/tasks">All</a>
  <% statuses.forEach((s) => { %>
    <a class="<%= activeStatus === s.value ? 'active' : '' %>" href="/projects/<%= project.id %>/tasks?status=<%= s.value %>"><%= s.label %></a>
  <% }) %>
</div>

<% if (tasks.length === 0) { %>
  <div class="panel">
    <div class="empty">
      <strong>No tasks here</strong>
      <%= manager ? 'Create a task to get started.' : 'Nothing has been added yet.' %>
    </div>
  </div>
<% } else { %>
  <div class="panel list-panel">
    <% tasks.forEach((t) => { %>
      <a class="list-row" href="/projects/<%= project.id %>/tasks/<%= t.id %>">
        <div class="list-main">
          <span class="list-title"><%= t.title %></span>
          <span class="list-sub"><%= t.assignee ? 'Assigned to ' + t.assignee.name : 'Unassigned' %></span>
        </div>
        <div class="list-meta">
          <span class="badge status-<%= t.status %>"><%= statusLabels[t.status] %></span>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>

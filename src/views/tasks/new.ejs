<%- include('../partials/header', { narrow: true }) %>

<div class="page-head">
  <h1>New task</h1>
  <p><a href="/projects/<%= project.id %>"><%= project.name %></a></p>
</div>

<div class="panel">
  <form data-task-form data-url="/api/projects/<%= project.id %>/tasks" data-method="POST" data-redirect="/projects/<%= project.id %>/tasks/{id}">
    <div class="message"></div>

    <div class="field">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" required maxlength="200">
    </div>

    <div class="field">
      <label for="description">Description <span class="hint">(optional)</span></label>
      <textarea id="description" name="description" rows="4" maxlength="2000"></textarea>
    </div>

    <div class="field">
      <label for="assignedTo">Assign to</label>
      <select id="assignedTo" name="assignedTo" class="full">
        <option value="">Unassigned</option>
        <% members.forEach((m) => { %>
          <option value="<%= m.userId %>"><%= m.user.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="field">
      <label for="status">Status</label>
      <select id="status" name="status" class="full">
        <% statuses.forEach((s) => { %>
          <option value="<%= s.value %>"><%= s.label %></option>
        <% }) %>
      </select>
    </div>

    <div class="field">
      <label for="attachments">Attachments <span class="hint">(up to 5 files, 5 MB each: images, PDF, TXT, CSV)</span></label>
      <input type="file" id="attachments" name="attachments" multiple accept=".png,.jpg,.jpeg,.gif,.webp,.pdf,.txt,.csv">
    </div>

    <button type="submit">Create task</button>
  </form>
</div>

<p class="note"><a href="/projects/<%= project.id %>/tasks">Back to tasks</a></p>

<%- include('../partials/footer', { scripts: ['/js/tasks.js'] }) %>

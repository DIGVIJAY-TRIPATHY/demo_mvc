<%- include('../partials/header', { narrow: true }) %>

<div class="page-head">
  <h1>Change password</h1>
  <p>Changing your password logs you out of your other devices.</p>
</div>

<div class="panel">
  <form data-api="/api/auth/change-password" data-clear="true">
    <div class="message"></div>

    <div class="field">
      <label for="currentPassword">Current password</label>
      <input type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password">
    </div>

    <div class="field">
      <label for="newPassword">New password <span class="hint">(at least 8 characters)</span></label>
      <input type="password" id="newPassword" name="newPassword" required minlength="8" autocomplete="new-password">
    </div>

    <div class="field">
      <label for="confirmPassword">Confirm new password</label>
      <input type="password" id="confirmPassword" name="confirmPassword" required minlength="8" autocomplete="new-password">
    </div>

    <button type="submit">Update password</button>
  </form>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/header', { layout: 'auth' }) %>

<h1>Forgot your password?</h1>
<p class="lead">Enter your email and we will send you a link to choose a new one.</p>

<form data-api="/api/auth/forgot-password" data-clear="true">
  <div class="message"></div>

  <div class="field">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" required autocomplete="email">
  </div>

  <button type="submit">Send reset link</button>
</form>

<p class="switch"><a href="/login">Back to log in</a></p>

<%- include('../partials/footer', { layout: 'auth' }) %>

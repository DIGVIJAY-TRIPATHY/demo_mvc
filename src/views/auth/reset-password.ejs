<%- include('../partials/header', { layout: 'auth' }) %>

<h1>Choose a new password</h1>

<% if (!token || !email) { %>
  <p class="lead">This reset link is not valid.</p>
  <a class="btn" href="/forgot-password">Request a new link</a>
<% } else { %>
  <p class="lead">Pick something you have not used before.</p>

  <form data-api="/api/auth/reset-password" data-redirect="/login" data-delay="1500">
    <div class="message"></div>

    <input type="hidden" name="token" value="<%= token %>">
    <input type="hidden" name="email" value="<%= email %>">

    <div class="field">
      <label for="newPassword">New password <span class="hint">(at least 8 characters)</span></label>
      <input type="password" id="newPassword" name="newPassword" required minlength="8" autocomplete="new-password">
    </div>

    <div class="field">
      <label for="confirmPassword">Confirm new password</label>
      <input type="password" id="confirmPassword" name="confirmPassword" required minlength="8" autocomplete="new-password">
    </div>

    <button type="submit">Reset password</button>
  </form>
<% } %>

<%- include('../partials/footer', { layout: 'auth' }) %>
